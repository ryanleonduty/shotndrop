<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Reading a screenshot dragged onto the shelf is a user-selection gesture;
	     read-only is enough since dropped files are only copied into the app's
	     own temporary session store, never modified in place. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Sparkle fetches the appcast and downloads updates over the network. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Required by Sparkle under the sandbox: lets the app reach Sparkle's
	     bundled Installer/Downloader XPC services (installs run outside the
	     sandbox). Names must be "<bundle id>-spks" and "-spki". -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
